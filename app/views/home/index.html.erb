<% content_for :banner do %>
  <div id="banner"></div>
<% end %>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "VideoGame",
  "name": "FortressOne",
  "alternateName": ["QWTF", "QuakeWorld Team Fortress", "Quake Team Fortress"],
  "url": "https://www.fortressone.org/",
  "description": "Free, open source revival of QuakeWorld Team Fortress (QWTF), the original 1996 Quake mod.",
  "genre": ["First-person shooter", "Capture the flag"],
  "gamePlatform": ["Windows", "Linux"],
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "sameAs": [
    "https://github.com/FortressOne",
    "https://www.moddb.com/games/fortressone",
    "https://drzel.itch.io/fortressone",
    "https://www.igdb.com/games/fortressone"
  ]
}
</script>

<main class="container">
  <section>
    <hgroup>
    <h1>Fortress<span class="one">One</span></h1>
    <h2>QuakeWorld Team Fortress (QWTF) Remastered</h2>
    </hgroup>

    <p>Free and open source fork of QuakeWorld Team Fortress (QWTF), the original 1996 Quake mod. Fast-paced, class based, arena first person shooter remastered with refined graphics, new mechanics and evolved gameplay.</p>

    <div class="site-metrics">
      <div class="metric"><b><%= number_with_delimiter(@metrics[:matches]) %></b><span><%= link_to "Matches", stats_path %></span></div>
      <div class="metric"><b><%= number_with_delimiter(@metrics[:players]) %></b><span><%= link_to "Players", players_path %></span></div>
      <div class="metric"><b><%= number_with_delimiter(@metrics[:caps]) %></b><span>Flag captures</span></div>
      <div class="metric"><b><%= number_with_delimiter(@metrics[:frags]) %></b><span>Frags</span></div>
      <% if @code_metrics %>
      <div class="metric"><b><%= number_with_delimiter(@code_metrics[:commits]) %></b><span><a href="https://github.com/FortressOne">Commits</a></span></div>
      <div class="metric"><b><%= number_with_delimiter(@code_metrics[:contributors]) %></b><span><a href="https://github.com/FortressOne">Contributors</a></span></div>
      <% end %>
    </div>
  </section>

  <section>
    <div class="grid">
      <div>
        <hgroup>
        <h2>Download</h2>
        <h3>Extract and run</h3>
        </hgroup>

        <p>Latest release (12 August 2023):</p>

        <ul>
          <li><a href="https://github.com/FortressOne/fte-config/releases/download/1.1.1-beta.3/fortressone-fte-windows-1.1.1-beta.3-portable.zip">Windows v1.1.1-beta.3</a></li>
          <li><a href="https://github.com/FortressOne/fte-config/releases/download/1.1.1-beta.3/fortressone-fte-linux-1.1.1-beta.3-portable.zip">Linux v1.1.1-beta.3</a></li>
        </ul>

        <p>Optional extras:</p>

        <ul>
          <li><a href="https://fortressone-share.s3.ap-southeast-2.amazonaws.com/hivis.zip">Hi vis models pack</a></br><small>Extract to <code>FortressOne/fortress/</code></small></li>
          <li><a href="https://fortressone-share.s3.ap-southeast-2.amazonaws.com/quake106_deiced.zip">Shareware Quake v1.06</a></li>
          <li><a href="https://maps.fortressone.org">Maps</a></li>
        </ul>

        <p>Pick-up games are organised on <a href="https://discord.fortressone.org">Discord</a>.
      </div>
      <div>
        <%= turbo_frame_tag :live_player_show, src: live_player_show_path, loading: :lazy do %>
          <%= render "video_frame", locals: { h2: "Watch", h3: "loading..." } do %>
            <div class="responsive-iframe">
              <div class="box"></div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>

