    <div class="grid">
      <div>
        <hgroup>
        <h2>Video</h2>
        <h3>In game action</h3>
        </hgroup>
        <ul>
          <li><a href="https://www.youtube.com/channel/UCgYzKaEyTNoVfRLwlpfKzFQ">YouTube</a></li>
          <li><a href="https://www.twitch.tv/FortressOne">Twitch channel</a></li>
          <li><a href="https://www.twitch.tv/directory/game/FortressOne">Twitch category</a></li>
        </ul>
      </div>
      <div>
        <hgroup>
        <h2>Play</h2>
        <h3>Chat, code, learn</h3>
        </hgroup>
        <ul>
          <li><a href="https://discord.fortressone.org">Discord</a></li>
          <li><a href="https://github.com/fortressone">GitHub</a></li>
          <li><a href="https://github.com/FortressOne/wiki/wiki">Wiki</a></li>
        </ul>
      </div>
      <div>
        <hgroup>
        <h2>Featured</h2>
        <h3>Around the web</h3>
        </hgroup>
        <ul>
          <li><a href="https://www.moddb.com/games/fortressone">ModDB</a></li>
          <li><a href="https://drzel.itch.io/fortressone">itch.io</a></li>
          <li><a href="https://www.igdb.com/games/fortressone">IGDB</a></li>
        </ul>
      </div>
      <div>
