  <section id="classes" data-nosnippet>
    <hgroup>
    <h2>Classes</h2>
    <h3>The low-down on each</h3>
    </hgroup>

    <div class="class-cards">
      <% Playerclass.all.each do |playerclass_id, playerclass| %>
        <article class="class-card">
          <header>
            <% playerclass[:images].each do |_colour, image| %>
              <%= image_tag(image[:url], alt: image[:alt]) %>
            <% end %>
            <span class="num"><%= playerclass_id %></span>
            <h3><%= playerclass[:name] %></h3>
          </header>
          <div class="class-card-body">
            <div>
              <div class="kv"><span>Speed</span><b><%= playerclass[:speed] %> <em>u/s</em></b></div>
              <div class="kv"><span>Armour</span><b><%= playerclass[:armour] %></b></div>
              <div class="mini">
                <h4>Specials</h4>
                <ul class="slots">
                  <% playerclass[:specials].each_with_index do |special, index| %>
                    <li><span class="slot"><%= index + 1 %></span><%= special %></li>
                  <% end %>
                </ul>
              </div>
              <% if playerclass[:attributes].any? %>
                <div class="mini">
                  <h4>Abilities</h4>
                  <% if playerclass[:attributes].many? %>
                    <ul class="abilities">
                      <% playerclass[:attributes].each do |ability| %>
                        <li><%= ability %></li>
                      <% end %>
                    </ul>
                  <% else %>
                    <p><%= playerclass[:attributes].first %></p>
                  <% end %>
                </div>
              <% end %>
            </div>
            <div>
              <div class="mini">
                <h4>Weapons</h4>
                <ul class="slots">
                  <% playerclass[:weapons].each_with_index do |weapon, index| %>
                    <li><span class="slot"><%= index + 1 %></span><%= weapon.present? ? weapon_label_icons(weapon) : tag.span("&mdash;".html_safe, style: "color: var(--text-dim);") %></li>
                  <% end %>
                </ul>
              </div>
              <div class="mini">
                <h4>Grenades</h4>
                <ul class="slots">
                  <% playerclass[:grenades].each_with_index do |grenade, index| %>
                    <li><span class="slot"><%= index + 1 %></span><%= weapon_label_icons(grenade) %></li>
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
        </article>
      <% end %>
    </div>
  </section>

  <section id="controls">
    <hgroup>
    <h2>Controls</h2>
