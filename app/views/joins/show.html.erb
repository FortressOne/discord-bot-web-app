<main class="container" style="max-width: 27rem; padding-top: 6vh;">
  <article style="text-align: center;">
    <hgroup>
      <h1><%= @spectate ? "Spectate" : "Join" %> this game</h1>
      <h2><code><%= @address %></code></h2>
    </hgroup>

    <%= link_to "Launch FortressOne",
                "fo://#{@spectate ? 'spectate' : 'join'}/#{@address}",
                role: :button, style: "width: 100%;" %>

    <p style="margin-top: 1rem;">
      <small>
        Nothing happened? You need the game first —
        <%= link_to "download FortressOne", root_path %>, run
        <code>install-desktop.sh</code> once, then click again.<br>
        Or connect manually: open the console and type
        <code>connect <%= @address %></code>
      </small>
    </p>
  </article>
</main>
