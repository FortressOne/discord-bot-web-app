<% content_for :title, "Link your game account" %>
<main class="container" style="max-width: 27rem; padding-top: 6vh;">
  <article>
    <hgroup style="text-align: center;">
      <h1>Link your game</h1>
      <h2>Approve the sign-in code shown in your FortressOne game menu.</h2>
    </hgroup>

    <% if player_signed_in? %>
      <%= form_with url: link_path, method: :post, data: { turbo: false } do |f| %>
        <%= f.text_field :code, value: @code, placeholder: "ABCD-1234", autofocus: @code.blank?,
                         autocomplete: "off",
                         style: "text-transform: uppercase; text-align: center; width: 100%; " \
                                "font-family: monospace; font-size: 1.4rem; letter-spacing: 0.12em; " \
                                "margin-bottom: 0.75rem;" %>
        <%= f.submit "Approve this game client", style: "width: 100%; margin-bottom: 0.75rem;" %>
      <% end %>
      <p style="text-align: center; margin-bottom: 0;">
        <small>Your game will be signed in as <strong><%= current_player.name %></strong>.</small>
      </p>
      <footer>
        <small>Only approve codes you got from your own game. Anyone holding an approved
        code can play as you.</small>
      </footer>
    <% else %>
      <p style="text-align: center;">Sign in with Discord to approve the code shown in your
      FortressOne game menu.</p>
      <%= button_to(
        "Sign in with Discord",
        player_discord_omniauth_authorize_path,
        data: { turbo: false },
        role: :button,
        class: "secondary",
        form: { style: "text-align: center;" }
      ) %>
    <% end %>
  </article>
</main>
