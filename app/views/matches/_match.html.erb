<div id="<%= dom_id match %>">
  <article>
    <header>
      <p>
        <span style="float: right;"><%= match.id %><%= DELIMITER %><%= local_time(match.created_at) %><small> (<%= local_time_ago(match.created_at) %>)</small></span>
        <% if match.server %>
          Server: <%= link_to(match.server.name, "qw://#{match.server.address}", style: "text-align: left;") %></br>
        <% end %>
        <% if match.discord_channel %>
          Discord: <%= link_to(match.discord_channel.name, match.discord_channel, style: "text-align: left;") %></br>
        <% end %>
        <h4><%= match_summary(match) %></h4>
      </p>

      <progress style='--progress-color: <%= match.result_colour %>;' value=<%= match.progress_value %> max="1200"></progress>
    </header>
    <div style="display: flex; flex-wrap: wrap; gap: 1rem 3rem; align-items: center;">
      <% [match.team(1), match.team(2)].each_with_index do |team, index| %>
        <% next unless team %>
        <div style="flex: 0 0 auto;">
          <span style="display: inline-flex; align-items: center; gap: 0.4rem; font-size: 1.3rem;">
            <%= image_tag(team.flag[:url], alt: team.flag[:alt], style: "height: 44px;") %>
            <strong><%= team.description %></strong>
          </span>
          </br>
          <% team.discord_channel_player_teams.each do |dcpt| %>
            <span style="white-space: nowrap; display: inline-flex; align-items: center; gap: 0.3rem; font-size: 1.3rem;">
              <% dcpt.images.each do |pc| %>
                <%= image_tag(pc[:url], alt: pc[:alt], style: "height: 44px;") %>
              <% end %>
              <%= link_to(dcpt.name, dcpt.player) %>
            </span>
            </br>
          <% end %>
        </div>
        <% if index.zero? %>
          <div style="flex: 1 0 auto; text-align: center; min-width: 10rem;">
            <h1><%= match.score %></h1>
          </div>
        <% end %>
      <% end %>
    </div>
    <footer>
      <%= link_to("Stats", match.match_stat ? stat_path(match.match_stat) : match.stats_uri) %>
      <%= DELIMITER %>
      <%= link_to("Demo", match.demo_uri) %>
    </footer>
  </article>
</div>
