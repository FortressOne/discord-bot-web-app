<% content_for :title, "QWTF pick-up match results#{" — page #{params[:page]}" if params[:page].to_i > 1}" %>
<div class="container">
  <p style="color: green"><%= notice %></p>

  <h1>Matches</h1>

  <div id="matches">
    <%== pagy_nav(@pagy) %>

    <% @matches.each do |match| %>
      <%= render match %>
    <% end %>

    <%== pagy_nav(@pagy) %>
  </div>
</div>
