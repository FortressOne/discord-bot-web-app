<main class="container">
  <%= render_breadcrumbs %>

  <div style="display: flex; gap: 1rem; margin-bottom: 30px;">
    <% if @player.image %>
      <%= image_tag @player.image, style: "margin-top: 0.5rem; border-radius: 50%;" %>
    <% end %>

    <hgroup>
    <h2><%= @player.name %></h2>
    <h3>
      Has played <%= @player.match_count %> matches</br>
      Last played <%= @player.last_match_date && local_time_ago(@player.last_match_date) %>
    </h3>
    </hgroup>
  </div>

  <% if @player == current_player || current_player&.admin? %>
    <p>
      Connect to a FortressOne server and enter
      <code>/login <%= TflToken.mint(@player) %></code>
      at the console.
    </p>

  <% end %>

  <h3>Career stats</h3>
  <figure>
    <table id="player_table" style="white-space: nowrap; max-width: 200px;" role="grid">
      <thead>
        <tr>
          <td>Played</td>
          <td>Wins</td>
          <td>Losses</td>
          <td>Draws</td>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><%= @player.match_count %></td>
          <td><%= @player.win_count %></td>
          <td><%= @player.loss_count %></td>
          <td><%= @player.draw_count %></td>
        </tr>
      </tbody>
    </table>
  </figure>

  <% matches, kills, deaths, teamkills, damage, takes, caps, stops, carry, sentries = @career_totals %>
  <% if matches.to_i.positive? %>
    <figure>
      <table role="grid" style="white-space: nowrap;">
        <thead>
          <tr>
            <th>Matches</th>
            <th>Kills</th>
            <th>Deaths</th>
            <th>K/(D+TK)</th>
            <th>Team Kills</th>
            <th>Damage</th>
            <th>Takes</th>
            <th>Caps</th>
            <th>Stops</th>
            <th>Carry</th>
            <th title="Sentries destroyed">Sentries</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><%= link_to number_with_delimiter(matches), stats_path(player_id: @player.id) %></td>
            <td><%= number_with_delimiter(kills) %></td>
            <td><%= number_with_delimiter(deaths) %></td>
            <td><%= (deaths.to_i + teamkills.to_i).zero? ? kills.to_f : (kills.to_f / (deaths.to_i + teamkills.to_i)).round(2) %></td>
            <td><%= number_with_delimiter(teamkills) %></td>
            <td><%= number_with_delimiter(damage) %></td>
            <td><%= number_with_delimiter(takes) %></td>
            <td><%= number_with_delimiter(caps) %></td>
            <td><%= number_with_delimiter(stops) %></td>
            <td><%= format("%d:%02d:%02d", carry.to_i / 3600, carry.to_i % 3600 / 60, carry.to_i % 60) %></td>
            <td><%= number_with_delimiter(sentries) %></td>
          </tr>
        </tbody>
      </table>
    </figure>

    <% if @career_classes.any? %>
      <div style="max-width: 34rem;">
        <%= bar_chart @career_classes.sort_by { |_, seconds| -seconds }
                                     .map { |name, seconds| [name, (seconds / 3600.0).round(1)] },
                      height: "260px", suffix: "h", colors: ["#f2d13c"], xtitle: "Hours" %>
      </div>
    <% end %>
  <% end %>



  <% @player.discord_channel_players_with_matches_played.each do |dcp| %>
    <section>
      <figure>
        <%= link_to dcp.discord_channel.name, discord_channel_path(dcp.discord_channel) %>
        <table id="player_discord_channels_table" style="white-space: nowrap;" role="grid">
          <thead>
            <tr>
              <% if true %>
                <th data-sort-method='number'>CSE</th>
                <th>Tier</th>
                <th data-sort-method='number'>Rank</th>
                <th data-sort-method='dotsep'>Percentile</th>
              <% end %>
              <th data-sort-method='number'>Played</th>
              <th data-sort-method='number'>Wins</th>
              <th data-sort-method='number'>Losses</th>
              <th data-sort-method='number'>Draws</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <% if true %>
                <td><%= number_with_precision(dcp.conservative_skill_estimate, precision: 2) %></td>
                <td><%= dcp.tier %></td>
                <td><%= dcp.rank %>/<%= dcp.discord_channel.discord_channel_players.count %></td>
                <td><%= dcp.percentile.to_i.ordinalize %></td>
              <% end %>
              <td><%= dcp.match_count %></td>
              <td><%= dcp.win_count %></td>
              <td><%= dcp.loss_count %></td>
              <td><%= dcp.draw_count %></td>
            </tr>
          </tbody>
        </table>
          <% if true %>
          <%= area_chart(
            dcp.trueskill_ratings_graph(60),
            xmin: 1,
            xmax: 60,
            height: "300px",
            min: nil,
            xtitle: "Last 60 matches",
            ytitle: "Conservative skill estimate") %>
      </figure>
    <% end %>
    </section>
  <% end %>
</main>
