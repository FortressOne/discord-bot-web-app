<% columns = local_assigns[:columns] || StatsHelper::FULL_COLUMNS %>
<% class_icons = local_assigns[:class_icons] || :used %>
<figure>
  <table role="grid" class="stats-table" data-sortable data-bold-max>
    <thead>
      <tr>
        <th>Player</th>
        <th>Classes</th>
        <% columns.each do |column| %>
          <% header, title = StatsHelper::STATS_COLUMNS.fetch(column) %>
          <th title="<%= title %>"><%= header.sub(" ", " ") %></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% rows.each do |player| %>
        <tr>
          <td><strong><%= stats_player_link(player) %></strong></td>
          <td><%= class_icons == :main ? stats_main_class_icons(player) : stats_class_icons(player) %></td>
          <% columns.each do |column| %>
            <%= stats_cell(player, column) %>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</figure>
