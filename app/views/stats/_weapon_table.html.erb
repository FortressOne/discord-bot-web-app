<figure>
  <table>
    <thead>
      <tr><th>Weapon</th><th>Shots</th><th>Hits</th><th>Acc</th><th>Damage</th><th>Kills</th></tr>
    </thead>
    <tbody>
      <% weapon_stats.sort_by { |_, stats| -stats["damage"].to_i }.each do |weapon, stats| %>
        <tr>
          <td><%= weapon %></td>
          <td><%= stats["shots"] %></td>
          <td><%= stats["hits"] %></td>
          <td><%= stats["shots"].to_i.positive? ? "#{(100.0 * stats["hits"].to_i / stats["shots"].to_i).round}%" : "" %></td>
          <td><%= stats["damage"] %></td>
          <td><%= stats["kills"] %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</figure>
