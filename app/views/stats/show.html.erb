<div class="container-stats">
  <p><%= link_to "← Match stats", stats_path %></p>

  <article>
    <header>
      <p>
        <span style="float: right;">
          <% if @match_stat.played_at %>
            <%= local_time(@match_stat.played_at) %>
          <% end %>
        </span>
        <%= stats_filter_link(@match_stat.region, :region, @match_stat.region) %> /
        <%= stats_filter_link(@match_stat.game_mode, :mode, @match_stat.game_mode) %>
        &middot; <%= @match_stat.duration_display %> min
      </p>
      <h4><%= @match_stat.map_name %></h4>
    </header>
    <div class="grid">
      <% [1, 2].each_with_index do |team, index| %>
        <div style="margin: auto;">
          <strong style="color: <%= team_colour_code(team) %>;"><%= (team == 1 ? @match_stat.team1_name : @match_stat.team2_name)&.capitalize || (team == 1 ? "Blue" : "Red") %></strong>
          </br>
          <% @players.select { |player| player.team == team }.each do |player| %>
            <%= stats_class_icon(player.dominant_class, StatsHelper::TEAM_COLOURS[team], height: 28) %>
            <%= stats_player_link(player) %>
            <% @awards.select { |award| award.player == player.name }.each do |award| %>
              <span title="<%= award.title %> (<%= award.description %>)"><%= award.emoji %></span>
            <% end %>
            </br>
          <% end %>
        </div>
        <% if index.zero? %>
          <div style="margin: auto; text-align: center;">
            <h1>
              <span style="color: <%= team_colour_code(1) %>;"><%= @match_stat.team1_score %></span>
              &ndash;
              <span style="color: <%= team_colour_code(2) %>;"><%= @match_stat.team2_score %></span>
            </h1>
            <p><strong><%= @match_stat.result_description %></strong></p>
          </div>
        <% end %>
      <% end %>
    </div>
    <footer>
      <%= link_to "Raw event log", @match_stat.json_url %>
      <% if @match_stat.match %>
        &middot; <%= link_to "PUG result", @match_stat.match %>
      <% end %>
      <% if @match_stat.demo_filename.present? && @match_stat.match&.demo_uri.present? %>
        &middot; <%= link_to "Demo", @match_stat.match.demo_uri %>
      <% end %>
    </footer>
  </article>

  <% if @awards.any? %>
    <h3>Awards</h3>
    <div class="grid">
      <% @awards.each_slice((@awards.size / 2.0).ceil).each do |column| %>
        <div>
          <table>
            <tbody>
              <% column.each do |award| %>
                <tr>
                  <td><strong><%= award.emoji %> <%= award.title %></strong><br><small><%= award.description %></small></td>
                  <td><%= stats_display_name(award.player) %><br><small><%= award.value %></small></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  <% end %>

  <h3>Players</h3>
  <%= render "players_table", rows: @players %>

  <% @breakdown.tables.each do |role, rows| %>
    <% next if rows.empty? %>
    <h3><%= { attack: "Attack", defence: "Defence", first_half: "First half", second_half: "Second half" }[role] %></h3>
    <%= render "players_table", rows: rows, columns: StatsHelper::ROLE_COLUMNS[role] %>
  <% end %>

  <% grouped_matchups = @breakdown.matchups.group_by(&:role) %>
  <% if grouped_matchups.any? %>
    <h3>Head to head</h3>
    <% if @breakdown.weighted? %>
      <p><small>⚖️ The match ended <%= @breakdown.ended_early_display %> early, so shortened-half values are scaled up by <%= @breakdown.weight_percent %>% — shown as <strong>weighted (actual)</strong>.</small></p>
    <% end %>
    <% grouped_matchups.each do |role, matchups| %>
      <h4><%= role == :attack ? "Attack" : "Defence" %></h4>
      <div style="display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 1rem; align-items: flex-start;">
        <% matchups.each do |matchup| %>
          <article style="margin: 0; flex: 0 1 auto; min-width: 300px; max-width: 100%;">
            <header style="padding: 0.5rem 1rem; text-align: center;">
              <strong><%= stats_class_full_name(matchup.class_name) %></strong>
            </header>
            <table class="h2h-table">
              <thead>
                <tr>
                  <th>
                    <span style="white-space: nowrap; display: inline-flex; align-items: center;">
                      <%= stats_class_icon(matchup.class_name, :blue) %>
                      <%= stats_class_icon(matchup.class_name, :red) %>
                    </span>
                  </th>
                  <% [matchup.left, matchup.right].each do |side| %>
                    <th style="color: <%= team_colour_code(side.team) %>;"><%= stats_display_name(side.name) %></th>
                  <% end %>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% stat_rows = matchup_stat_rows(@breakdown, matchup) %>
                <% stat_rows.each do |label, left, right, options| %>
                  <% clock = options.delete(:clock) || false %>
                  <% left_html, right_html = duel_pair(left, right, **options) %>
                  <tr>
                    <td><%= label %></td>
                    <td><%= left_html %></td>
                    <td><%= right_html %></td>
                    <td><%= duel_margin(left, right, matchup.left.team, matchup.right.team,
                                        lower_wins: options.fetch(:lower_wins, false), clock: clock) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </article>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <h3>Weapons</h3>
  <% @players.each do |player| %>
    <details>
      <summary>
        <span style="color: <%= team_colour_code(player.team) %>;"><strong><%= stats_display_name(player.name) %></strong></span>
        <small><%= player.class_breakdown %></small>
      </summary>
      <figure>
        <table>
          <thead>
            <tr><th>Weapon</th><th>Shots</th><th>Hits</th><th>Acc</th><th>Damage</th><th>Kills</th></tr>
          </thead>
          <tbody>
            <% player.weapon_stats.sort_by { |_, s| -s["damage"].to_i }.each do |weapon, stats| %>
              <tr>
                <td><%= weapon %></td>
                <td><%= stats["shots"] %></td>
                <td><%= stats["hits"] %></td>
                <td><%= stats["shots"].to_i.positive? ? "#{(100.0 * stats["hits"].to_i / stats["shots"].to_i).round}%" : "" %></td>
                <td><%= stats["damage"] %></td>
                <td><%= stats["kills"] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </figure>
    </details>
  <% end %>
</div>
