<div class="container-stats">
  <p><%= link_to "← Match stats", stats_path %></p>

  <%= render "shared/result_card", card: result_card_for_match_stat(@match_stat, players: @players, awards: @awards) %>

  <% if @breakdown.weighted? %>
    <p><small>⚖️ The match ended <%= @breakdown.ended_early_display %> early, so shortened-half values are scaled up by <%= @breakdown.weight_percent %>% — shown as <strong>weighted (actual)</strong>.</small></p>
  <% end %>

  <h3>Teams</h3>
  <figure>
    <table class="stats-table" data-bold-max>
      <thead>
        <tr>
          <th>Team</th>
          <th>Score</th>
          <th title="Flag captures">Caps</th>
          <th title="Kills">Kills</th>
          <th title="Deaths">Deaths</th>
          <th title="Team kills">Team Kills</th>
          <th title="Flag carry time">Carry</th>
          <th title="Flag takes">Takes</th>
        </tr>
      </thead>
      <tbody>
        <% team_scores = [1, 2].index_with { |team| (team == 1 ? @match_stat.team1_score : @match_stat.team2_score).to_i } %>
        <% weighted_scores = team_scores.to_h { |team, score| [team, (score * (@match_stat.attack_defence ? @breakdown.half_weight(team) : 1)).round] } %>
        <% [1, 2].sort_by { |team| -weighted_scores[team] }.each do |team| %>
          <% members = @weighted_players.select { |player| player.team.to_i == team && !player.unteamed? } %>
          <tr>
            <td><strong style="color: <%= team_colour_code(team) %>;"><%= ((team == 1 ? @match_stat.team1_name : @match_stat.team2_name).presence || Team::COLOUR[team]).capitalize %></strong></td>
            <td data-sort="<%= weighted_scores[team] %>"><%= weighted_scores[team] == team_scores[team] ? team_scores[team] : weighted_pair_display(weighted_scores[team], team_scores[team]) %></td>
            <%= stats_totals_cell(members, :flag_caps) %>
            <%= stats_totals_cell(members, :kills) %>
            <%= stats_totals_cell(members, :deaths) %>
            <%= stats_totals_cell(members, :teamkills) %>
            <%= stats_totals_cell(members, :flag_carry_seconds, clock: true) %>
            <%= stats_totals_cell(members, :flag_touches) %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </figure>

  <% if @match_stat.cap_timeline.present? %>
    <h3>Timeline</h3>
    <%
      # Both attacking runs overlay on one clock: each cap plots at its
      # time INTO the half, and each team's line ends at their own half
      # length (an early red win ends their line short).
      duration = @match_stat.duration_seconds.to_i
      boundary = @match_stat.half_boundary_seconds || duration / 2
      overlay = @match_stat.attack_defence && boundary.positive?
      half_lengths = { 1 => boundary, 2 => duration - boundary }
      series = { 1 => { 0 => 0 }, 2 => { 0 => 0 } }
      counts = { 1 => 0, 2 => 0 }
      @match_stat.cap_timeline.each do |cap|
        team = cap["team"].to_i
        next unless series.key?(team)

        time = cap["t"].to_i
        time -= boundary if overlay && time > boundary
        counts[team] += 1
        series[team][(time / 60.0).round(2)] = counts[team]
      end
      series.each do |team, data|
        line_end = overlay ? half_lengths[team] : duration
        data[(line_end / 60.0).round(2)] = data.values.last
      end
    %>
    <div style="max-width: 60rem;">
      <%= line_chart [
            { name: (@match_stat.team1_name.presence || "Blue").capitalize, data: series[1], color: "#3FA3F5" },
            { name: (@match_stat.team2_name.presence || "Red").capitalize, data: series[2], color: "#D24435" }
          ],
          height: "180px", xtitle: overlay ? "Minutes into the half" : "Minutes", ytitle: "Caps", curve: false,
          library: { scales: { y: { ticks: { stepSize: 1 } } }, elements: { line: { stepped: true } } } %>
    </div>
  <% end %>

  <% if @awards.any? %>
    <h3>Awards</h3>
    <figure>
      <table class="stats-table">
        <tbody>
          <% @awards.each do |award| %>
            <tr>
              <td><%= award.emoji %> <strong><%= award.title %></strong></td>
              <td><small><%= award.description %></small></td>
              <td><%= safe_join(award.players.map { |name| winner = @players.find { |player| player.name == name }; winner ? stats_player_link(winner) : stats_display_name(name) }, ", ") %></td>
              <td><%= stats_actual_small(award.value) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </figure>
  <% end %>

  <% @breakdown.tables.each do |role, rows| %>
    <% next if rows.empty? %>
    <h3><%= { attack: "Attack", defence: "Defence", first_half: "First half", second_half: "Second half" }[role] %></h3>
    <%= render "players_table", rows: rows, columns: StatsHelper::ROLE_COLUMNS[role] %>
  <% end %>

  <details <%= "open" unless @breakdown.any? %>>
    <summary><h3 style="display: inline;">Overall</h3></summary>
    <%= render "players_table", rows: @weighted_players, class_icons: :main %>
  </details>

  <% grouped_matchups = @breakdown.matchups.group_by(&:role) %>
  <% if grouped_matchups.any? %>
    <h3>Head to head</h3>
    <% grouped_matchups.each do |role, matchups| %>
      <h4><%= role == :attack ? "Attack" : "Defence" %></h4>
      <div style="display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 1rem; align-items: flex-start;">
        <% matchups.each do |matchup| %>
          <article style="margin: 0; flex: 0 1 auto; min-width: 300px; max-width: 100%;">
            <header style="padding: 0.5rem 1rem; text-align: center;">
              <strong><%= stats_class_full_name(matchup.class_name) %></strong>
            </header>
            <table class="h2h-table">
              <thead>
                <tr>
                  <th>
                    <span style="white-space: nowrap; display: inline-flex; align-items: center;">
                      <%= stats_class_icon(matchup.class_name, :blue) %>
                      <%= stats_class_icon(matchup.class_name, :red) %>
                    </span>
                  </th>
                  <% [matchup.left, matchup.right].each do |side| %>
                    <th style="color: <%= team_colour_code(side.team) %>;<%= " background-color: rgba(242, 209, 60, 0.10);" if stats_own_row?(side) %>" title="<%= stats_display_name(side.name) %>"><%= stats_display_name(side.name) %></th>
                  <% end %>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% stat_rows = matchup_stat_rows(@breakdown, matchup) %>
                <% stat_rows.each do |label, left, right, options| %>
                  <% clock = options.delete(:clock) || false %>
                  <% neutral = options.delete(:neutral) || false %>
                  <% left_html, right_html = neutral ? [options[:left_display] || left, options[:right_display] || right] : duel_pair(left, right, **options) %>
                  <tr>
                    <td><%= label %></td>
                    <td><%= left_html %></td>
                    <td><%= right_html %></td>
                    <td><%= neutral ? "" : duel_margin(left, right, matchup.left.team, matchup.right.team,
                                                       lower_wins: options.fetch(:lower_wins, false), clock: clock) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </article>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <h3>Player Stats</h3>
  <% @players.each do |player| %>
    <details <% if stats_own_row?(player) %>style="background-color: rgba(242, 209, 60, 0.10); border-radius: 0.25rem;"<% end %>>
      <summary>
        <span style="color: <%= player.unteamed? ? '#FFFFFF' : team_colour_code(player.team) %>;"><strong><%= stats_display_name(player.name) %></strong></span>
        <small><%= player.class_breakdown %></small>
      </summary>
      <% blocks = @breakdown.attack_defence? ? stats_role_blocks(player) : [] %>
      <% if blocks.any? %>
        <% blocks.each do |role, data, team| %>
          <div style="margin-bottom: 1.25rem;">
            <h5 style="color: <%= team_colour_code(team) %>;"><%= role %></h5>
            <p>
              <small><%= stats_class_breakdown(data["class_seconds"] || {}) %></small>
            </p>
            <div style="display: flex; flex-wrap: wrap; gap: 1.5rem; align-items: flex-start;">
              <% if data["weapon_stats"].present? %>
                <div style="flex: 0 1 auto; min-width: 300px;">
                  <h6>Weapon Stats</h6>
                  <%= render "weapon_table", weapon_stats: data["weapon_stats"] %>
                </div>
              <% end %>
              <% if data["damage_received"].present? %>
                <div style="flex: 0 1 auto; min-width: 300px;">
                  <h6>Damage Received</h6>
                  <%= render "damage_received_table", damage_received: data["damage_received"] %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      <% else %>
        <div style="display: flex; flex-wrap: wrap; gap: 1.5rem; align-items: flex-start;">
          <div style="flex: 0 1 auto; min-width: 300px;">
            <h6>Weapon Stats</h6>
            <%= render "weapon_table", weapon_stats: player.weapon_stats %>
          </div>
          <% if player.damage_received.present? %>
            <div style="flex: 0 1 auto; min-width: 300px;">
              <h6>Damage Received</h6>
              <%= render "damage_received_table", damage_received: player.damage_received %>
            </div>
          <% end %>
        </div>
      <% end %>
    </details>
  <% end %>

  <% matrix_players = @players.reject(&:unteamed?) + @players.select(&:unteamed?) %>
  <% if @match_stat.kill_matrix.present? %>
    <h3>Kill Matrix</h3>
    <figure>
      <table class="stats-table kill-matrix">
        <thead>
          <tr>
            <th>Killer \\ Victim</th>
            <% matrix_players.each_with_index do |victim, index| %>
              <th title="<%= stats_display_name(victim.name) %>"><%= index + 1 %></th>
            <% end %>
            <th>Total</th>
          </tr>
        </thead>
        <tbody>
          <% matrix_players.each_with_index do |killer, index| %>
            <tr <% if stats_own_row?(killer) %>style="background-color: rgba(242, 209, 60, 0.10);"<% end %>>
              <td><strong style="color: <%= killer.unteamed? ? '#FFFFFF' : team_colour_code(killer.team) %>;"><%= index + 1 %>. <%= stats_display_name(killer.name) %></strong></td>
              <% row = @match_stat.kill_matrix[killer.name] || {} %>
              <% matrix_players.each do |victim| %>
                <% kills = row.dig(victim.name, "kills").to_i %>
                <td title="<%= stats_display_name(killer.name) %> killed <%= stats_display_name(victim.name) %> <%= kills %> times"><%= kills.nonzero? %></td>
              <% end %>
              <td><strong><%= row.sum { |_, cell| cell["kills"].to_i } %></strong></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </figure>
  <% end %>
</div>
