<div class="container-stats">
  <p><%= link_to "← Match stats", stats_path %></p>

  <article>
    <header>
      <p>
        <span style="float: right;"><%= @match_stat.played_at&.strftime("%Y-%m-%d %H:%M") %> UTC</span>
        <%= stats_filter_link(@match_stat.region, :region, @match_stat.region) %> /
        <%= stats_filter_link(@match_stat.game_mode, :mode, @match_stat.game_mode) %>
        &middot; <%= @match_stat.duration_display %> min
      </p>
      <h4><%= @match_stat.map_name %></h4>
    </header>
    <div class="grid">
      <% [1, 2].each_with_index do |team, index| %>
        <div style="margin: auto;">
          <strong style="color: <%= team_colour_code(team) %>;"><%= (team == 1 ? @match_stat.team1_name : @match_stat.team2_name)&.capitalize || (team == 1 ? "Blue" : "Red") %></strong>
          </br>
          <% @players.select { |player| player.team == team }.each do |player| %>
            <%= stats_class_icon(player.dominant_class, StatsHelper::TEAM_COLOURS[team], height: 28) %>
            <%= stats_player_link(player) %>
            </br>
          <% end %>
        </div>
        <% if index.zero? %>
          <div style="margin: auto; text-align: center;">
            <h1>
              <span style="color: <%= team_colour_code(1) %>;"><%= @match_stat.team1_score %></span>
              &ndash;
              <span style="color: <%= team_colour_code(2) %>;"><%= @match_stat.team2_score %></span>
            </h1>
            <p><strong><%= @match_stat.drawn? ? "Draw!" : "#{(@match_stat.winning_team == 1 ? @match_stat.team1_name : @match_stat.team2_name)&.capitalize} wins" %></strong></p>
          </div>
        <% end %>
      <% end %>
    </div>
    <footer>
      <%= link_to "Raw event log", @match_stat.json_url %>
      <% if @match_stat.match %>
        &middot; <%= link_to "PUG result", @match_stat.match %>
      <% end %>
      <% if @match_stat.demo_filename.present? && @match_stat.match&.demo_uri.present? %>
        &middot; <%= link_to "Demo", @match_stat.match.demo_uri %>
      <% end %>
    </footer>
  </article>

  <% if @awards.any? %>
    <h3>Awards</h3>
    <div class="grid">
      <% @awards.each_slice((@awards.size / 2.0).ceil).each do |column| %>
        <div>
          <table>
            <tbody>
              <% column.each do |award| %>
                <tr>
                  <td><strong><%= award.title %></strong><br><small><%= award.description %></small></td>
                  <td><%= award.player %><br><small><%= award.value %></small></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  <% end %>

  <h3>Players</h3>
  <%= render "players_table", rows: @players %>

  <% @breakdown.tables.each do |role, rows| %>
    <% next if rows.empty? %>
    <h3><%= { attack: "Attack", defence: "Defence", first_half: "First half", second_half: "Second half" }[role] %></h3>
    <%= render "players_table", rows: rows, columns: StatsHelper::ROLE_COLUMNS[role] %>
  <% end %>

  <% grouped_matchups = @breakdown.matchups.group_by(&:role) %>
  <% if grouped_matchups.any? %>
    <h3>Head to head</h3>
    <% grouped_matchups.each do |role, matchups| %>
      <h4><%= role == :attack ? "Attack" : "Defence" %></h4>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 1rem; margin-bottom: 1rem;">
        <% matchups.each do |matchup| %>
          <article style="margin: 0;">
            <header style="padding: 0.5rem 1rem; text-align: center;">
              <strong><%= matchup.class_name %></strong>
            </header>
            <table>
              <thead>
                <tr>
                  <th></th>
                  <th style="color: <%= team_colour_code(matchup.left.team) %>;">
                    <%= stats_class_icon(matchup.class_name, StatsHelper::TEAM_COLOURS[matchup.left.team]) %>
                    <%= matchup.left.name %>
                  </th>
                  <th style="color: <%= team_colour_code(matchup.right.team) %>;">
                    <%= stats_class_icon(matchup.class_name, StatsHelper::TEAM_COLOURS[matchup.right.team]) %>
                    <%= matchup.right.name %>
                  </th>
                </tr>
              </thead>
              <tbody>
                <% if matchup.role == :attack %>
                  <tr><td>Caps</td><td><%= matchup.left.flag_caps %></td><td><%= matchup.right.flag_caps %></td></tr>
                  <tr><td>Carry</td><td><%= matchup.left.flag_carry_display %></td><td><%= matchup.right.flag_carry_display %></td></tr>
                  <tr><td>Took</td><td><%= matchup.left.flag_touches %></td><td><%= matchup.right.flag_touches %></td></tr>
                <% else %>
                  <tr><td>Stops</td><td><%= matchup.left.flag_stops %></td><td><%= matchup.right.flag_stops %></td></tr>
                <% end %>
                <tr><td>Kills</td><td><%= matchup.left.kills %></td><td><%= matchup.right.kills %></td></tr>
                <tr><td>Deaths</td><td><%= matchup.left.deaths %></td><td><%= matchup.right.deaths %></td></tr>
                <tr><td>Damage</td><td><%= matchup.left.damage_given %></td><td><%= matchup.right.damage_given %></td></tr>
                <tr><td>Dmg taken</td><td><%= matchup.left.damage_taken %></td><td><%= matchup.right.damage_taken %></td></tr>
              </tbody>
            </table>
            <footer style="padding: 0.5rem 1rem;">
              <small>
                Duels: <%= matchup.left.name %> <%= matchup.duels[:left_kills] %> &ndash; <%= matchup.duels[:right_kills] %> <%= matchup.right.name %>
                (dmg <%= matchup.duels[:left_damage] %> &ndash; <%= matchup.duels[:right_damage] %>)
              </small>
            </footer>
          </article>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <h3>Weapons</h3>
  <% @players.each do |player| %>
    <details>
      <summary>
        <span style="color: <%= team_colour_code(player.team) %>;"><strong><%= player.name %></strong></span>
        <small><%= player.class_breakdown %></small>
      </summary>
      <figure>
        <table>
          <thead>
            <tr><th>Weapon</th><th>Shots</th><th>Hits</th><th>Acc</th><th>Damage</th><th>Kills</th></tr>
          </thead>
          <tbody>
            <% player.weapon_stats.sort_by { |_, s| -s["damage"].to_i }.each do |weapon, stats| %>
              <tr>
                <td><%= weapon %></td>
                <td><%= stats["shots"] %></td>
                <td><%= stats["hits"] %></td>
                <td><%= stats["shots"].to_i.positive? ? "#{(100.0 * stats["hits"].to_i / stats["shots"].to_i).round}%" : "" %></td>
                <td><%= stats["damage"] %></td>
                <td><%= stats["kills"] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </figure>
    </details>
  <% end %>
</div>
