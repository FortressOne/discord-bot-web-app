<div class="container-stats">
  <p><%= link_to "← Match stats", stats_path %></p>

  <article>
    <header>
      <p>
        <span style="float: right;"><%= @match_stat.id %><%= DELIMITER %><% if @match_stat.played_at %><%= local_time(@match_stat.played_at) %><small> (<%= local_time_ago(@match_stat.played_at) %>)</small><% end %></span>
        <% if @match_stat.match&.server %>
          Server: <%= link_to(@match_stat.match.server.name, "qw://#{@match_stat.match.server.address}", style: "text-align: left;") %></br>
        <% end %>
        <% if @match_stat.match&.discord_channel %>
          Discord: <%= link_to(@match_stat.match.discord_channel.name, @match_stat.match.discord_channel, style: "text-align: left;") %></br>
        <% end %>
        <% unless @match_stat.match %>
          Region: <%= stats_filter_link(@match_stat.region, :region, @match_stat.region) %></br>
          Mode: <%= stats_filter_link(@match_stat.game_mode, :mode, @match_stat.game_mode) %></br>
        <% end %>
        <h4><%= stats_match_summary(@match_stat, @players) %></h4>
      </p>

      <progress style='--progress-color: <%= @match_stat.result_colour %>;' value=<%= @match_stat.progress_value %> max="<%= @match_stat.progress_max %>"></progress>
    </header>
    <div class="grid">
      <% [1, 2].each_with_index do |team, index| %>
        <div style="margin: auto;">
          <% flag = Team::FLAGS.fetch(team, Team::DEFAULT_FLAG) %>
          <%= image_tag(flag[:url], alt: flag[:alt], style: "height: 44px;") %>
          <strong><%= "#{((team == 1 ? @match_stat.team1_name : @match_stat.team2_name).presence || Team::COLOUR[team]).capitalize} Team" %></strong>
          </br>
          <% @players.select { |player| player.team == team && !player.unteamed? }.each do |player| %>
            <%= stats_class_icon(player.dominant_class, StatsHelper::TEAM_COLOURS[team], height: 44) %>
            <% if player.player_id %>
              <%= link_to(stats_display_name(player.name), player_path(player.player_id)) %>
            <% else %>
              <%= link_to(stats_display_name(player.name), stats_path(player: player.name)) %>
            <% end %>
            <% @awards.select { |award| award.player == player.name }.each do |award| %>
              <span title="<%= award.title %> (<%= award.description %>)"><%= award.emoji %></span>
            <% end %>
            </br>
          <% end %>
        </div>
        <% if index.zero? %>
          <div style="margin: auto;">
            <h1><%= @match_stat.team1_score %> &mdash; <%= @match_stat.team2_score %></h1>
          </div>
        <% end %>
      <% end %>
    </div>
    <footer>
      <%= link_to "Raw event log", @match_stat.json_url %>
      <% if @match_stat.match %>
        <%= DELIMITER %><%= link_to "PUG result", @match_stat.match %>
      <% end %>
      <% if @match_stat.demo_filename.present? && @match_stat.match&.demo_uri.present? %>
        <%= DELIMITER %><%= link_to "Demo", @match_stat.match.demo_uri %>
      <% end %>
    </footer>
  </article>

  <% if @awards.any? %>
    <h3>Awards</h3>
    <div class="grid">
      <% @awards.each_slice((@awards.size / 2.0).ceil).each do |column| %>
        <div>
          <table>
            <tbody>
              <% column.each do |award| %>
                <tr>
                  <td><strong><%= award.emoji %> <%= award.title %></strong><br><small><%= award.description %></small></td>
                  <td><%= stats_display_name(award.player) %><br><small><%= award.value %></small></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  <% end %>

  <h3>Players</h3>
  <%= render "players_table", rows: @players %>

  <% if @breakdown.weighted? && @breakdown.any? %>
    <p><small>⚖️ The match ended <%= @breakdown.ended_early_display %> early, so shortened-half values are scaled up by <%= @breakdown.weight_percent %>% — shown as <strong>weighted (actual)</strong>.</small></p>
  <% end %>
  <% @breakdown.tables.each do |role, rows| %>
    <% next if rows.empty? %>
    <h3><%= { attack: "Attack", defence: "Defence", first_half: "First half", second_half: "Second half" }[role] %></h3>
    <%= render "players_table", rows: rows, columns: StatsHelper::ROLE_COLUMNS[role] %>
  <% end %>

  <% grouped_matchups = @breakdown.matchups.group_by(&:role) %>
  <% if grouped_matchups.any? %>
    <h3>Head to head</h3>
    <% grouped_matchups.each do |role, matchups| %>
      <h4><%= role == :attack ? "Attack" : "Defence" %></h4>
      <div style="display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 1rem; align-items: flex-start;">
        <% matchups.each do |matchup| %>
          <article style="margin: 0; flex: 0 1 auto; min-width: 300px; max-width: 100%;">
            <header style="padding: 0.5rem 1rem; text-align: center;">
              <strong><%= stats_class_full_name(matchup.class_name) %></strong>
            </header>
            <table class="h2h-table">
              <thead>
                <tr>
                  <th>
                    <span style="white-space: nowrap; display: inline-flex; align-items: center;">
                      <%= stats_class_icon(matchup.class_name, :blue) %>
                      <%= stats_class_icon(matchup.class_name, :red) %>
                    </span>
                  </th>
                  <% [matchup.left, matchup.right].each do |side| %>
                    <th style="color: <%= team_colour_code(side.team) %>;" title="<%= stats_display_name(side.name) %>"><%= stats_display_name(side.name) %></th>
                  <% end %>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% stat_rows = matchup_stat_rows(@breakdown, matchup) %>
                <% stat_rows.each do |label, left, right, options| %>
                  <% clock = options.delete(:clock) || false %>
                  <% left_html, right_html = duel_pair(left, right, **options) %>
                  <tr>
                    <td><%= label %></td>
                    <td><%= left_html %></td>
                    <td><%= right_html %></td>
                    <td><%= duel_margin(left, right, matchup.left.team, matchup.right.team,
                                        lower_wins: options.fetch(:lower_wins, false), clock: clock) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </article>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <h3>Weapons</h3>
  <% @players.each do |player| %>
    <% if player.unteamed? && player.half_stats.values.any? { |half| half["weapon_stats"].present? } %>
      <%# All-time attackers get one entry per half, coloured by the team
          they attacked with. %>
      <% player.half_stats.sort.each do |_, half| %>
        <% next if half["weapon_stats"].blank? %>
        <details>
          <summary>
            <span style="color: <%= team_colour_code(half["team"]) %>;"><strong><%= stats_display_name(player.name) %></strong></span>
            <small><%= stats_class_breakdown(half["class_seconds"] || {}) %></small>
          </summary>
          <%= render "weapon_table", weapon_stats: half["weapon_stats"] %>
        </details>
      <% end %>
    <% else %>
      <details>
        <summary>
          <span style="color: <%= team_colour_code(player.team) %>;"><strong><%= stats_display_name(player.name) %></strong></span>
          <small><%= player.class_breakdown %></small>
        </summary>
        <%= render "weapon_table", weapon_stats: player.weapon_stats %>
      </details>
    <% end %>
  <% end %>
</div>
